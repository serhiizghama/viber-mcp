{
  "name": "viber-mcp",
  "version": "0.1.0",
  "description": "MCP server for the Viber Bot REST API",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "viber-mcp": "dist/index.js"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "start": "node dist/index.js",
