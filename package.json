{
  "name": "@serhii.zghama/viber-mcp",
  "version": "0.1.0",
  "description": "MCP server for the Viber Bot REST API — drive a Viber bot from Claude Desktop, Claude Code, or any MCP client",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "viber-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "viber",
    "mcp",
    "model-context-protocol",
    "chatbot",
    "ai",
    "claude",
    "bot",
    "messaging"
  ],
  "author": "Serhii Zghama <zmrser@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/serhiizghama/viber-mcp.git"
  },
  "homepage": "https://github.com/serhiizghama/viber-mcp#readme",
  "bugs": {
    "url": "https://github.com/serhiizghama/viber-mcp/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.29.2",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
